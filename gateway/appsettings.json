{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "booking-route": {
        "ClusterId": "booking-cluster",
        "Match": { "Path": "/booking/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/booking" } ]
      },
      "events-route": {
        "ClusterId": "event-cluster",
        "Match": { "Path": "/events/{**catch-all}" }
      },
      "venues-route": {
        "ClusterId": "event-cluster",
        "Match": { "Path": "/venues/{**catch-all}" }
      },
      "categories-route": {
        "ClusterId": "event-cluster",
        "Match": { "Path": "/categories" }
      },
      "payments-route": {
        "ClusterId": "payment-cluster",
        "Match": { "Path": "/payments/{**catch-all}" }
      },
      "users-route": {
        "ClusterId": "user-cluster",
        "Match": { "Path": "/users/{**catch-all}" }
      }
    },
    "Clusters": {
      "booking-cluster": {
        "Destinations": {
          "booking": { "Address": "http://massseats-booking:8080/" }
        }
      },
      "event-cluster": {
        "Destinations": {
          "event": { "Address": "http://massseats-event:8080/" }
        }
      },
      "payment-cluster": {
        "Destinations": {
          "payment": { "Address": "http://massseats-payment:8080/" }
        }
      },
      "user-cluster": {
        "Destinations": {
          "user": { "Address": "http://massseats-user:8080/" }
        }
      }
    }
  },
  "Jwt": {
    "SecretKey": "CHANGE-ME-to-a-secret-key-at-least-32-chars-long",
    "Issuer": "MassSeats",
    "Audience": "massseats-api",
    "ExpiryMinutes": 60
  }
}
