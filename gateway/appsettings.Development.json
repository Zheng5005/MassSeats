{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "ReverseProxy": {
    "Clusters": {
      "booking-cluster": {
        "Destinations": {
          "booking": { "Address": "http://localhost:5281/" }
        }
      },
      "event-cluster": {
        "Destinations": {
          "event": { "Address": "http://localhost:5144/" }
        }
      },
      "payment-cluster": {
        "Destinations": {
          "payment": { "Address": "http://localhost:5002/" }
        }
      },
      "user-cluster": {
        "Destinations": {
          "user": { "Address": "http://localhost:5026/" }
        }
      }
    }
  },
  "Jwt": {
    "SecretKey": "CHANGE-ME-to-a-secret-key-at-least-32-chars-long",
    "Issuer": "MassSeats",
    "Audience": "massseats-api",
    "ExpiryMinutes": 60
  }
}
